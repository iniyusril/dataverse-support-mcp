# Copy to .env for local testing (never commit .env). In Hermes, put these under mcp_servers.<name>.env.

DV_URL=https://yourorg.crm5.dynamics.com
DV_TENANT_ID=00000000-0000-0000-0000-000000000000
DV_CLIENT_ID=00000000-0000-0000-0000-000000000000
DV_CLIENT_SECRET=change-me

# Recommended
DV_SUPPORT_ADDRESS=support@yourdomain.com
DV_SENDER_QUEUE_ID=00000000-0000-0000-0000-000000000000
DV_REPLY_SIGNATURE=Best regards,\nSupport Team

# Leave unset until the drafts look good. Only then: DV_ALLOW_SEND=true
# DV_ALLOW_SEND=false

# Optional
# DV_PROCESSED_FIELD=ts_hermes_processed
# DV_BLOCKED_SENDERS=@spam.example,someone@example.com
# DV_MAX_BODY_CHARS=8000
# DV_LOG_LEVEL=INFO
